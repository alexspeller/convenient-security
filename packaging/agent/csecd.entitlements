<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for csecd, the one set every build is signed with.

     The data-protection keychain under our own team-prefixed access group, and
     the CloudKit container the iPhone remote-approval relay uses. Every key but
     the apple-events one is restricted: the embedded Developer ID provisioning
     profile must authorize it, or AMFI kills csecd at launch. build-agent.sh
     checks that before it signs anything.

     CloudKit is always the Production environment: a Developer ID app may use
     CloudKit, but only in Production, and the iPhone app is built against the
     same environment so the two share one mailbox. Holding the entitlement does
     not turn remote approval on; csecd performs no CloudKit request until a
     phone is paired.

     No App Sandbox (Developer ID doesn't need it, and the agent shells out to
     `op` and shares a $TMPDIR socket). The keychain group is proven by
     packaging/spike. build-agent.sh fills in the team and identifier from
     identity.xcconfig before it signs. -->
<plist version="1.0">
<dict>
    <key>com.apple.application-identifier</key>
    <string>@CSEC_TEAM_ID@.@CSEC_IDENTIFIER@</string>
    <!-- Xcode signs every CloudKit Mac app with its team identifier; the
         Developer ID profile authorizes it. -->
    <key>com.apple.developer.team-identifier</key>
    <string>@CSEC_TEAM_ID@</string>
    <key>keychain-access-groups</key>
    <array>
        <string>@CSEC_TEAM_ID@.@CSEC_IDENTIFIER@</string>
    </array>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.@CSEC_IDENTIFIER@</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <key>com.apple.developer.icloud-container-environment</key>
    <string>Production</string>
    <!-- Hardened runtime: allow the Apple events that ask iTerm2 / Terminal.app
         which tab a request came from (TerminalSessionContext). Not restricted;
         no provisioning-profile authorization needed. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
