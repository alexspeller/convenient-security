<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The LaunchAgent that runs csecd. Ships inside the app at
     Contents/Library/LaunchAgents/ and is registered by `csec install` via
     SMAppService.agent(plistName:). BundleProgram is bundle-relative so the app
     can be relocated. A LaunchAgent (not a daemon) because the SE / data-
     protection keychain / Touch ID are user-login-session-only. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alexspeller.convenient-security</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/csecd</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Interactive: it presents Touch ID and serves an interactive user. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <!-- No inherited provider configuration or credential environment. csecd
         uses fixed absolute paths and gives `op` a small allowlisted environment.
         It writes its own log to the private 0700 socket dir, so no Standard*Path
         entries are needed here. -->
</dict>
</plist>
