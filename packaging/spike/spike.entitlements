<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Minimal entitlements to exercise the data-protection keychain under our own
     access group. application-identifier + keychain-access-groups must be
     authorized by the embedded Developer ID provisioning profile. No App Sandbox
     (not needed for Developer ID; the real agent also shells out to `op`). -->
<plist version="1.0">
<dict>
    <key>com.apple.application-identifier</key>
    <string>8RS6GD89Y7.com.alexspeller.convenient-security</string>
    <key>keychain-access-groups</key>
    <array>
        <string>8RS6GD89Y7.com.alexspeller.convenient-security</string>
    </array>
</dict>
</plist>
