#!/bin/bash
set -eu

# Installer scripts run as root. Keep the language-client bridge outside the
# admin-group-writable /Applications directory so same-uid malware cannot swap
# the path Ruby executes before csecd gets a chance to authenticate it.
bridge_root="/Library/Application Support/ConvenientSecurity"
app="/Applications/ConvenientSecurity.app"
root_label="com.alexspeller.convenient-security.rootd"
root_helper="/Library/PrivilegedHelperTools/$root_label"
root_plist="/Library/LaunchDaemons/$root_label.plist"
[ ! -L "$bridge_root" ] && [ -d "$bridge_root/bin" ] \
  && [ ! -L "$bridge_root/bin" ] && [ -f "$bridge_root/bin/csec" ] \
  && [ ! -L "$bridge_root/bin/csec" ] || {
    echo "Convenient Security bridge payload has an unsafe path shape" >&2
    exit 1
  }
[ ! -L "$app" ] && [ -d "$app" ] || {
  echo "Convenient Security app payload has an unsafe path shape" >&2
  exit 1
}
[ ! -L "$root_helper" ] && [ -f "$root_helper" ] \
  && [ ! -L "$root_plist" ] && [ -f "$root_plist" ] || {
    echo "Convenient Security root-helper payload has an unsafe path shape" >&2
    exit 1
  }
/usr/sbin/chown -R root:wheel "$bridge_root"
/bin/chmod 0755 "$bridge_root" "$bridge_root/bin" "$bridge_root/bin/csec"
/usr/sbin/chown root:wheel "$root_helper" "$root_plist"
/bin/chmod 0755 "$root_helper"
/bin/chmod 0644 "$root_plist"

for protected_path in \
  / \
  /Library \
  "/Library/Application Support" \
  "$bridge_root" \
  "$bridge_root/bin" \
  "$bridge_root/bin/csec" \
  /Library/PrivilegedHelperTools \
  "$root_helper" \
  /Library/LaunchDaemons \
  "$root_plist"; do
  owner="$(/usr/bin/stat -f %u "$protected_path")"
  mode="$(/usr/bin/stat -f %Lp "$protected_path")"
  if [ "$owner" != "0" ] || [ $((8#$mode & 022)) -ne 0 ]; then
    echo "Convenient Security bridge path is not independently protected: $protected_path" >&2
    exit 1
  fi
done

# The app itself is still live-code authenticated on every connection, but root
# ownership also prevents in-place modification of its signed contents.
/usr/sbin/chown -R root:wheel "$app"

/usr/bin/codesign --verify --strict "$bridge_root/bin/csec"
/usr/bin/codesign --verify --deep --strict "$app"
/usr/bin/codesign --verify --strict "$root_helper"
/usr/bin/plutil -lint "$root_plist" >/dev/null

product_requirement='anchor apple generic and certificate leaf[subject.OU] = "8RS6GD89Y7"'
/usr/bin/codesign --verify --strict \
  -R="$product_requirement and identifier \"com.alexspeller.convenient-security.csec\"" \
  "$bridge_root/bin/csec"
/usr/bin/codesign --verify --deep --strict \
  -R="$product_requirement and identifier \"com.alexspeller.convenient-security\"" \
  "$app"
/usr/bin/codesign --verify --strict \
  -R="$product_requirement and identifier \"$root_label\"" \
  "$root_helper"

# Upgrade from the service manager's perspective only after every new path and
# signature passes. bootout completes asynchronously, so the bounded helper
# waits out launchd's removal transaction before loading the fixed plist.
script_directory="$(cd "$(dirname "$0")" && pwd)"
"$script_directory/reload-launch-daemon" /bin/launchctl "$root_label" "$root_plist"

exit 0
