  edit = agent[/An edit or import is setup at this Mac.*?policyReview\.reviewAccess\(review\)/m]
  abort "Agent.swift: a native edit or import must build a macOnly review" unless
    edit && edit.include?("macOnly: true")
  abort "RemoteApprovalPolicyReview.swift: MirroredPolicyReview must send host remediation to the local panel only" unless
    mirror =~ /public func reviewHostRemediation\(\s*_ review: HostRemediationReview\s*\) async -> HostRemediationOutcome \{\s*await local\.reviewHostRemediation\(review\)\s*\}/
' "$repo_root/agent/Sources/ConvenientSecurity/SSHSigningService.swift" \
