# B2: the sealed host-audit baseline. No shipping path reads or writes a
# plaintext baseline: only the sealed store names the old file, to import it
# once and to delete it. Every store operation is serialized; the plaintext is
# imported only from the no-pointer branch after the committed-file check; a
# write seals a new file, bumps the pointer, renames, and only then deletes
# the old file, and puts the previous pointer back when its own bump failed;
# and nothing is sealed or pointed at once uninstall began. With a pointer in
# place, a directory or file csecd cannot list or read is a finding, never a
# quiet "unavailable". csecd repairs access (an ACL, a mode) only on its own
# objects: a sealed file must be a single-link regular file examined through
# its own descriptor, and B1's mode repair skips a file with a second link, so
# a hard link planted under csecd's name never changes someone else's file.
# Every change says what it is for. A save never seals over an unrecorded
# finding, and
# every save that does not take is reported. The host-audit service changes
# the baseline only through the atomic update, and csecd installs the store
# and hands its erase to uninstall.
sealed_baseline="$repo_root/agent/Sources/ConvenientSecurity/HostAudit/SealedBaselineStore.swift"
plaintext_baseline_users="$(
  rg -l -F 'host-audit-baseline.json' "$repo_root/agent/Sources" -g '!**/cs-selftest/**' |
    rg -v -F -x "$sealed_baseline" || true
)"
if [ -n "$plaintext_baseline_users" ] ||
  rg -q 'FileBaselineStore' "$repo_root/agent/Sources"; then
  echo "only SealedBaselineStore.swift may name the plaintext host-audit baseline, and FileBaselineStore is gone:" >&2
  [ -n "$plaintext_baseline_users" ] && echo "$plaintext_baseline_users" >&2
  exit 1
fi
ruby -e '
  store, service, context, csecd, sealed = ARGV.map { |path| File.read(path) }
  def body(source, signature)
    source[/#{Regexp.escape(signature)}.*?\n    }\n/m] or abort "missing #{signature}"
  end
  ["public func open(", "public func load(", "public func save(", "public func update(",
   "public func eraseForUninstall("].each do |signature|
    abort "SealedBaselineStore.swift: #{signature} must run through serialized" unless
      body(store, signature).include?("await serialized {")
  end
  resolve = body(store, "private func resolve() async -> Current {")
  abort "SealedBaselineStore.swift: resolve() must check the uninstalled state first" unless
    resolve =~ /\A[^\n]*\n\s*guard !stores\.isUninstalled else/
  abort "SealedBaselineStore.swift: only a missing pointer may lead to an import" unless
    resolve.include?("case .absent:\n            return await resolveWithoutPointer(key: key)") &&
    store.scan("await resolveWithoutPointer(").size == 1
  without = body(store, "private func resolveWithoutPointer(")
  migrate = without.index("await migrate(key: key)")
  abort "SealedBaselineStore.swift: the plaintext is imported only after the committed-file check" unless
    store.scan("await migrate(key:").size == 1 && migrate &&
    without.index("if !committed.isEmpty {") && without.index("if !committed.isEmpty {") < migrate
  def guarded_before(fn, call)
    guard = fn.index("guard !stores.isUninstalled")
    at = fn.index(call)
    guard && at && guard < at
  end
  write = body(store, "private func writeSealed(")
  abort "SealedBaselineStore.swift: a sealed file is written only by writeSealed, after the uninstalled check" unless
    store.scan("writeAtomically(").size == 1 && guarded_before(write, "writeAtomically(")
  commit = body(store, "private func commitPointer(")
  abort "SealedBaselineStore.swift: the pointer is written only by commitPointer, after the uninstalled check" unless
    store.scan("pointerStore.prepare(").size == 1 && guarded_before(commit, "pointerStore.prepare(")
  seal = body(store, "private func seal(")
  order = ["guard !stores.isUninstalled", "writeSealed(pending", "commitPointer(pointer)",
           "directory.rename(pending", "removeEntries(of: listing, except: keep)"]
  positions = order.map { |step| seal.index(step) }
  bump = seal.index("commitPointer(pointer)")
  deletions = seal.enum_for(:scan, /removeEntries\(|directory\.remove\(/).map { Regexp.last_match.begin(0) }
  abort "SealedBaselineStore.swift: a write seals the new file, bumps the pointer, renames, then deletes the old file" unless
    positions.all? && positions == positions.sort && seal.scan("removeEntries(").size == 1 &&
    deletions.all? { |at| at > bump }
  abort "SealedBaselineStore.swift: a failed bump puts the previous pointer straight back" unless
    seal.include?("await commitPointer(previous)")
  inspect = body(store, "private func inspect(")
  abort "SealedBaselineStore.swift: with a pointer, a listing or read csecd cannot make is a finding, not unavailable" unless
    inspect.include?("case let .failed(reason):\n            return .finding(.fileUnreadable") &&
    inspect.include?("} catch {\n            return .finding(.fileUnreadable") &&
    inspect.scan(".unavailable(").size == 1
  save = body(store, "private func write(")
  abort "SealedBaselineStore.swift: a save never seals over an unrecorded finding, and every refusal is reported" unless
    save.include?("guard reportedTamper?.recorded == true else { return notSaved(change) }") &&
    !save.include?("return false") && body(store, "private func notSaved(").include?("onNotice(.notSaved(change, ")
  repair = body(store, "static func restoreOwnFile(")
  abort "SealedBaselineStore.swift: a sealed file is repaired only as a single-link regular file of this user, through its descriptor" unless
    repair.include?("owned.type == .regular") && repair.include?("owned.links == 1") &&
    repair.include?("openat(directoryFD") && repair.include?("O_NOFOLLOW") &&
    repair.index("owned.links == 1") < repair.index("stripAccessControl(fd:")
  abort "SealedRecordFile.swift: the mode repair never changes a file with a second link" unless
    sealed.include?("directory || info.st_nlink == 1 else { return false }") &&
    sealed.include?("info.st_nlink == 1, fchmod(fd, mode_t(0o600))")
  updates = service.scan(/await store\.update\(for: \.(\w+)\) \{/).flatten
  abort "AgentProtocol.swift: the host-audit service changes the baseline only through the atomic update, naming each change" if
    service =~ /\.save\(/ || updates.sort != ["audit", "reminderStamp", "triage"]
  abort "Context.swift: the production audit context reads the installed baseline store" unless
    context.include?("baseline: any BaselineStoring = HostAuditService.baselineStore")
  abort "AgentRuntime.swift: csecd installs the baseline store and hands its erase to uninstall" unless
    csecd.include?("HostAuditService.installBaselineStore(store)") &&
    csecd.include?("await sealedBaseline.eraseForUninstall()") &&
    csecd.include?("fileCleanups: baselineCleanup")
' "$sealed_baseline" \
  "$repo_root/agent/Sources/ConvenientSecurity/HostAudit/AgentProtocol.swift" \
  "$repo_root/agent/Sources/ConvenientSecurity/HostAudit/Context.swift" \
  "$repo_root/agent/Sources/csecd/AgentRuntime.swift" \
  "$repo_root/agent/Sources/ConvenientSecurity/SealedRecordFile.swift"

# C1: delegated approvals' registration. `csec hook claude` registers the exact
# program with csecd before its rewrite reaches stdout: Claude Code runs nothing
# until the hook exits, so that order is what puts a registration ahead of the
# `csec ai` it describes. The registration is best effort, bounded by its own
# liveness with heartbeats refused (so no csecd heartbeat interval can stretch
# it) and by one overall deadline that covers the check of csecd's signature
# (a stalled trustd would otherwise hold the hook into Claude Code's 30 s
# timeout, which runs the command unwrapped), and never retried, so it can
# never change what the hook prints. And the
# Claude hook stays a passthrough rewrite: Claude Code takes an allow from
# hookSpecificOutput.permissionDecision and from a top-level "decision":
# "approve", and either would skip the auto-mode classifier whose verdict a
# delegated approval stands on. So the Claude rewrite is exactly
# {"hookSpecificOutput": {"hookEventName": "PreToolUse", "updatedInput": …}}
# and the file names no other approval key (the selftest pins the same on the
# output). Its only decision is the worktree escape check's deny.
ruby -e '
  main, hook, client = ARGV.map { |path| File.read(path) }
  run_hook = main[/^func runHook\(.*?\n}\n/m] or abort "csec/main.swift: runHook is missing"
  lines = run_hook.lines
  register = lines.index { |line| line.include?("registerAgentCommand(") }
  output = lines.index { |line| line.include?("FileHandle.standardOutput.write(output)") }
  abort "csec/main.swift: runHook must register the command before it writes the rewrite to stdout" unless
    register && output && register < output && run_hook.scan("registerAgentCommand(").size == 1 &&
    lines[0...register].none? { |line| line.include?("FileHandle.standardOutput.write") }
  abort "csec/main.swift: runHook must not retry the registration" if run_hook.include?("withCsecdReconnect")
  abort "AICommandHook.swift: the hook output must register before it returns, ignoring any registrar failure" unless
    hook =~ /if let registration = rewrite\.registration \{\n\s*try\? register\(registration\)\n\s*\}\n\s*return rewrite\.output\n/
  registration = client[/public func registerAgentCommand\(.*?\n    }\n/m] or
    abort "AgentClient.swift: registerAgentCommand is missing"
  abort "AgentClient.swift: the registration must be bounded by AgentLiveness.agentCommandRegistration" unless
    registration.include?("liveness: .agentCommandRegistration") && !registration.include?("liveness: liveness")
  abort "AgentClient.swift: the whole registration, the check of csecd included, must end at AgentLiveness.agentCommandRegistrationDeadline and never send once given up on" unless
    registration.include?("outcome.wait(seconds: AgentLiveness.agentCommandRegistrationDeadline)") &&
    registration.include?("cancellation.arm({ connection.interrupt() })") &&
    registration.include?("cancellation.cancel()")
  abort "AgentClient.swift: the registration must refuse heartbeats" unless
    registration.include?(".send(.registerAgentCommand(registration), supportsHeartbeats: false)") &&
    client =~ /if WireTransport\.isHeartbeat\(data\) \{\n\s*guard supportsHeartbeats else \{\n\s*throw /
  specific = hook[/static func hookSpecificOutput\(.*?\n    }\n/m] or
    abort "AICommandHook.swift: hookSpecificOutput is missing"
  claude = specific[/case \.claude:(.*?)case \.codex:/m, 1] or
    abort "AICommandHook.swift: hookSpecificOutput must answer .claude before .codex"
  abort "AICommandHook.swift: the Claude hook must stay a passthrough rewrite with no permissionDecision" if
    claude.include?("permissionDecision")
  abort "AICommandHook.swift: the Claude hookSpecificOutput must be exactly the PreToolUse event and updatedInput" unless
    claude =~ /\A\s*return \[\s*"hookEventName": "PreToolUse",\s*"updatedInput": updatedInput,\s*\]\s*\z/
  context = hook[/public static func rewriteWithContext\(.*?\n    }\n/m] or
    abort "AICommandHook.swift: rewriteWithContext is missing"
  abort "AICommandHook.swift: the hook output must be exactly one top-level hookSpecificOutput" unless
    context.scan("JSONSerialization.data(").size == 1 &&
    context.include?("withJSONObject: [\"hookSpecificOutput\": hookSpecificOutput(client: client, updatedInput: updatedInput)],")
  code = hook.lines.reject { |line| line.strip.start_with?("//") }.join
  %w["decision" "approve" "behavior" "continue" "async" "updatedPermissions"].each do |key|
    abort "AICommandHook.swift: #{key} is a Claude Code approval key the hook must never write" if code.include?(key)
  end
  # The one decision the Claude hook writes is a deny (the worktree escape
  # check), which grants nothing: claudeDenial writes exactly that, and
  # rewriteWithContext calls it once, with the refusal reason.
  denial = hook[/static func claudeDenial\(.*?\n    }\n/m] or
    abort "AICommandHook.swift: claudeDenial is missing"
  abort "AICommandHook.swift: claudeDenial must write exactly a PreToolUse deny with its reason" unless
    denial.include?("\"permissionDecision\": \"deny\",") && !denial.include?("allow") &&
    denial.scan("permissionDecision\":").size == 1 && denial.include?("\"hookEventName\": \"PreToolUse\",")
  abort "AICommandHook.swift: the hook may write permissionDecision only in the Codex output and claudeDenial" unless
    code.scan("\"permissionDecision\":").size == 2
  abort "AICommandHook.swift: rewriteWithContext must deny only with the worktree escape refusal" unless
    context.scan("claudeDenial(").size == 1 && context.include?("claudeDenial(reason: refusal.reason)") &&
    hook.scan("claudeDenial(").size == 2
' "$repo_root/agent/Sources/csec/main.swift" \
  "$repo_root/agent/Sources/ConvenientSecurity/AICommandHook.swift" \
  "$repo_root/agent/Sources/ConvenientSecurity/AgentClient.swift"

# C3: csecd's delegation service, where Claude Code auto mode may stand in for
# a panel. (1) No runtime switch: nothing the delegation service, its
# settings, its declines or the Claude settings gate read comes from the
# environment or argv (ProcessInfo.processInfo in any form, including an alias
# of it, a fresh ProcessInfo(), CommandLine, getenv, environ), and csecd
# builds exactly one service with exactly its protected stores, C1's gate
# factory, the default release manifest store (whose audited Claude Code list
# is trusted only once its pinned-key signature verifies) and the early
# update check: no test seam (the unverified-caller knob, an injected policy
# version, facts, clocks or a build list) reaches the shipping construction. (2) Warm-only:
# Agent's heldValue resolves a new reference with resolveWithoutInteraction,
# and releaseDelegated resolves only through it, telling it which references
# are new; SSHSigningService's signDelegated resolves its key only with
# resolveWithoutInteraction; the delegation files never resolve or unlock
# anything. (3) No mint: they never touch a grant table. (4) Sudo has no
# delegation (its review helper, the sudo panel and the PAM module never name
# it), and the access/SSH panel shows the note only in its shared footnote
# block, never in the automation layout. (5) A pairing is written only on the
# human-approval path: Agent calls recordHumanApproval once, after the
# approval completed, on a human surface that showed the pairing line, with
# the pairing selection, and the sudo review reports its own; the service adds
# pairings only from there. SSHSigningService writes none: an SSH signing auto
# mode approved signs with no pairing (csec-0.11).
delegation_dir="$repo_root/agent/Sources/ConvenientSecurity"
delegation_files=(
  "$delegation_dir/ClaudeDelegationService.swift"
  "$delegation_dir/ClaudeDelegationSSHChain.swift"
  "$delegation_dir/LauncherScript.swift"
  "$delegation_dir/DelegationPolicy.swift"
  "$delegation_dir/DelegationDecline.swift"
  "$delegation_dir/ClaudeSettingsGate.swift"
)
if rg -n 'ProcessInfo\.processInfo|ProcessInfo\(|CommandLine\.|getenv\(|\benviron\b' "${delegation_files[@]}"; then
  echo "delegated approvals: no environment variable or argument may reach the delegation service or the settings gate" >&2
  exit 1
fi
constructions="$(rg -l 'ClaudeDelegationService\(' "$repo_root/agent/Sources" \
  --glob '!**/cs-selftest/**' --glob '!**/cs-e2e/**' || true)"
if [ "$constructions" != "$repo_root/agent/Sources/csecd/AgentRuntime.swift" ]; then
  echo "delegated approvals: only csecd's AgentRuntime.swift builds a delegation service (found: $constructions)" >&2
  exit 1
fi
ruby -e '
  runtime = File.read(ARGV.fetch(0))
  abort "AgentRuntime.swift: csecd builds exactly one delegation service" unless
    runtime.scan("ClaudeDelegationService(").size == 1
  arguments = runtime[/ClaudeDelegationService\((.*?)\n\s*\)/m, 1] or
    abort "AgentRuntime.swift: the delegation service construction is missing"
  arguments = arguments.split(",").map(&:strip).reject(&:empty?)
  expected = ["stores: protectedStores", "gate: makeClaudeSettingsGate()", "consent: delegationSettingsConsent",
    "decisionLog: decisionLog", "terminalInspection: .live", "manifestStore: ReleaseManifestStore()",
    "uncheckedBuildSeen: { ReleaseUpdateSchedule.checkSoon() }",
    "credentialStore: KeychainClaudeCredentialStore.shared"]
  abort "AgentRuntime.swift: csecd builds the delegation service over its protected stores, the settings " \
    "gate factory, the live terminal inspector, the default signed release manifest store, the early " \
    "update check and the Keychain credential store, with no other argument " \
    "(got #{arguments.inspect})" unless arguments == expected
  # The services built before the mirror take the settings panel over the
  # local reviewer csecd built on the consent queue (their settings changes
  # are Mac-only, so the mirror would hand them to that reviewer anyway),
  # falling back to the queued bare sheet, and nothing else.
  settings = runtime[/^\s*let settingsConsent = SettingsChangeConsent\((.*?)\n\s*\)$/m, 1] or
    abort "AgentRuntime.swift: csecd builds settingsConsent as one SettingsChangeConsent"
  abort "AgentRuntime.swift: the settings consent is SettingsChangeConsent over the consent csecd built and " \
    "its local reviewer on the consent queue (got #{settings.inspect})" unless
    settings.split(/,\s*(?=review:)/).map(&:strip) ==
      ["underlying: consent", "review: QueuedPolicyReview(underlying: TrustedPolicyReview(), queue: consentQueue)"]
  # The delegation service takes the same panel over the mirrored reviewer csecd built
  # on that queue, so the paired phone can answer the rules- and hooks-changed
  # acknowledgement (av-rcqg); the mirror keeps every Mac-only change local.
  mirrored = runtime[/^\s*let delegationSettingsConsent = SettingsChangeConsent\((.*?)\n\s*\)$/m, 1] or
    abort "AgentRuntime.swift: csecd builds delegationSettingsConsent as one SettingsChangeConsent"
  abort "AgentRuntime.swift: the delegation settings consent is SettingsChangeConsent over the consent csecd " \
    "built and its mirrored policy reviewer (got #{mirrored.inspect})" unless
    mirrored.split(/,\s*(?=review:)/).map(&:strip) == ["underlying: consent", "review: policyReview"]
  policy = runtime[/^\s*let policyReview: PolicyReviewProvider = (QueuedPolicyReview\(.*?\n\s*\))$/m, 1] or
    abort "AgentRuntime.swift: csecd builds policyReview as one QueuedPolicyReview"
  abort "AgentRuntime.swift: policyReview is the mirrored reviewer on the consent queue (got #{policy.inspect})" unless
    policy.gsub(/\s+/, " ") ==
      "QueuedPolicyReview( underlying: MirroredPolicyReview(local: TrustedPolicyReview(), remote: remoteApproval), " \
      "queue: consentQueue )"
  abort "AgentRuntime.swift: csecd builds exactly two settings consents" unless
    runtime.scan("SettingsChangeConsent(").size == 2
  abort "AgentRuntime.swift: only the delegation service takes the mirrored settings consent" unless
    runtime.scan("consent: delegationSettingsConsent").size == 1
' "$repo_root/agent/Sources/csecd/AgentRuntime.swift"
# Every Touch ID csecd asks for on a setup step (backups, a restore, phone
# pairing, machine identities, removing an SSH key or an automation job,
# deleting stored files, the uninstall cleanup, host fixes, auto-mode settings)
# is csecd's settings panel, typing-guarded like every approval: Apple's bare
# sheet took a Space typed as it appeared as its Deny (csec-0.60). So only the
# consent providers (the fallback for a provider with no panel) ask for a bare
# sheet, only the Touch ID owners evaluate a policy, and csecd hands every
# service the settings consent except the two that never ask for one.
bare_sheet_callers="$(rg -n '\.authenticate(Explaining)?\((\s*$|reason:)' \
  "$repo_root/agent/Sources/ConvenientSecurity" "$repo_root/agent/Sources/csecd" \
  --glob '!**/ConvenientSecurity/Consent.swift' --glob '!**/ConvenientSecurity/ConsentQueue.swift' \
  --glob '!**/ConvenientSecurity/BiometricConsent.swift' --glob '!**/ConvenientSecurity/SettingsChangeConsent.swift' || true)"
if [ -n "$bare_sheet_callers" ]; then
  echo "settings panel: a csecd step asks for Apple's bare Touch ID sheet; use approveSettingsChange:" >&2
  echo "$bare_sheet_callers" >&2
  exit 1
fi
policy_evaluators="$(rg -l 'evaluatePolicy\(' "$repo_root/agent/Sources/ConvenientSecurity" "$repo_root/agent/Sources/csecd" | sort | tr '\n' ' ')"
if [ "$policy_evaluators" != "$repo_root/agent/Sources/ConvenientSecurity/BiometricConsent.swift $repo_root/agent/Sources/ConvenientSecurity/SudoAuthorizationReview.swift $repo_root/agent/Sources/ConvenientSecurity/TrustedAccessReviewSession.swift " ]; then
  echo "settings panel: only the consent sheet and the two review panels evaluate a Touch ID policy (found: $policy_evaluators)" >&2
  exit 1
fi
ruby -e '
  runtime = File.read(ARGV.fetch(0))
  plain = runtime.enum_for(:scan, /\bconsent: consent\b/).map do
    runtime[0...Regexp.last_match.begin(0)].scan(/(\w+)\(\s*\n/).flatten.last
  end
  abort "AgentRuntime.swift: only the grant restoration and the Agent take the plain consent; every other " \
    "service asks through settingsConsent (got #{plain.inspect})" unless plain == ["GrantRestoration", "Agent", "Agent"]
' "$repo_root/agent/Sources/csecd/AgentRuntime.swift"
if rg -n 'resolver\.resolve\(|unlock:' "$delegation_dir"/ClaudeDelegation*.swift; then
  echo "delegated approvals: the delegation service never resolves or unlocks anything" >&2
  exit 1
fi
ruby -e '
  agent, ssh, resolver = ARGV.map { |path| File.read(path) }
  def body(source, signature)
    source[/#{Regexp.escape(signature)}.*?\n    }\n/m] or abort "missing #{signature}"
  end
  held = body(agent, "private func heldValue(")
  abort "Agent.swift: heldValue must resolve a reference new to the request with no csec unlock" unless
    held.include?("if isNew { return await resolver.resolveForDelegation(ref) }")
  # A new reference is served warm, or else fetched only from a provider
  # that needs no csec unlock (1Password), never with an unlock or a csec
  # prompt: a reference behind the csec touch stays warm-only.
  for_delegation = body(resolver, "public func resolveForDelegation(")
  without_unlock = body(resolver, "public func resolveWithoutCsecUnlock(")
  abort "SecretResolver.swift: resolveForDelegation must try warm first, then fetch only from a provider " \
    "that needs no csec unlock, with no unlock" unless
    for_delegation.include?("if let held = await resolveWithoutInteraction(ref) { return .value(held) }") &&
    for_delegation.include?("!(await provider.requiresUnlockToResolve(ref))") &&
    !for_delegation.include?("unlock:") && for_delegation.scan("resolveWithoutCsecUnlock(ref)").size == 1 &&
    for_delegation.index("requiresUnlockToResolve") < for_delegation.index("resolveWithoutCsecUnlock(ref)") &&
    without_unlock.scan("unlock:").size == 1 && without_unlock.include?("try await resolve(ref, unlock: nil)")
  release = body(agent, "private func releaseDelegated(")
  abort "Agent.swift: releaseDelegated resolves only through heldValue" if
    release =~ /resolver\.resolve|unlock:/ || !release.include?("heldValue(")
  new_reference = "heldValue(ref, isNew: newReferenceURIs.contains(ref.uri))"
  abort "Agent.swift: releaseDelegated must tell heldValue which references are new to the request" unless
    release.scan("heldValue(").size == 1 && release.scan(new_reference).size == 1
  signing = body(ssh, "private func signDelegated(")
  abort "SSHSigningService.swift: signDelegated resolves its key only warm-only" if
    signing =~ /resolver\.resolve\(|unlock:/ || signing.scan(/resolver\.resolve\w*\(/).size != 1 ||
    signing.scan("resolver.resolveWithoutInteraction(reference)").size != 1
  # A delegated request that went to the restore panel resolves nothing on
  # the approval made before the wait: it is judged again from the start. It
  # joins the human-Deny ledger before it waits, and the second judgment
  # checks the ledger first, so a Deny of an identical request made during
  # the wait is never overruled by auto mode.
  [["Agent.swift", release], ["SSHSigningService.swift", signing]].each do |name, text|
    arrive = text.index("humanDenials.arrive()")
    wait = text.index("ensureWarmForDelegation(")
    abort "#{name}: a delegated request must take its Deny-ledger ticket before it waits on the restore panel" unless
      arrive && wait && arrive < wait && text.include?("return .waitedForRestore(arrival)")
  end
  abort "Agent.swift: a delegated release that waited on the restore panel must be judged again, " \
    "Deny ledger included" unless
    agent.include?("consentTurn: consentTurn, restoreWait: arrival") &&
    agent.include?("if let waited = consentTurn ?? restoreWait, let denialShape, humanDenials.refuses(")
  verdict = body(ssh, "private func delegatedVerdict(")
  refused = verdict.index("humanDenials.refuses(arrival")
  abort "SSHSigningService.swift: a delegated signing that waited on the restore panel must check the Deny " \
    "ledger, then be judged again" unless
    verdict.include?("mayWaitForRestore = false") && refused &&
    refused > verdict.index("case let .waitedForRestore(arrival):")
' "$delegation_dir/Agent.swift" "$delegation_dir/SSHSigningService.swift" "$delegation_dir/SecretResolver.swift"
if rg -n 'GrantTable|grants\.add|grants\.append' "$delegation_dir"/ClaudeDelegation*.swift; then
  echo "delegated approvals: delegation mints no grant" >&2
  exit 1
fi
# Delegated sudo lives in csecd and the review helper; the root PAM module
# only renders sudo's argv and runs the helper, and never names it.
if rg -n -i 'delegation|delegated|pairing' "$repo_root/packaging/sudo"; then
  echo "the sudo PAM module never names delegated approvals: csecd judges them for the review helper" >&2
  exit 1
fi
# The helper asks csecd before anything is drawn or mirrored, and an approval
# there ends the review at once; it reports a pairing only after a Touch ID on
# its own panel, which always shows the line it was given (a phone approval
# csecd records itself). The panel shows the note and the line below its
# footnote, the line never truncated and named for the probes, as the access
# and SSH panels do.
ruby -e '
  helper, panel = ARGV.map { |path| File.read(path) }
  main = helper[/^private func runReview\(\n  originalParent: pid_t, review: SudoAuthorizationReviewRequest, deadline: SudoReviewDeadline\n\) -> Never \{.*\z/m] or abort "csec-sudo-review: the review body is missing"
  ask = main.index("await SudoDelegationClient.installed.ask(")
  approved = main.index("if delegation.decision == .approved {\n      return deadline.decide() ? 0 : SudoReviewDeadline.expiredExitStatus")
  terminal = main.index("SudoDelegationClient.installed.terminal()")
  race = main.index("SudoReviewRace.run(")
  abort "csec-sudo-review: ask csecd about delegation first, and end an approved sudo before any panel or phone request" unless
    ask && approved && terminal && race && ask < approved && approved < terminal && approved < race &&
    helper.scan("SudoDelegationClient.installed.ask(").size == 1
  report = main.index("if outcome == .approved(on: .mac), review.pairingLine != nil {")
  pair = main.index("SudoDelegationClient.installed.pair(")
  abort "csec-sudo-review: report a pairing only after a Mac approval of a panel that showed the line" unless
    report && pair && race < report && report < pair && helper.scan("SudoDelegationClient.installed.pair(").size == 1
  configure = panel[/    private func configureWindow\(\).*?\n    }\n/m] or abort "SudoAuthorizationReview.swift: configureWindow is missing"
  note = configure.index("if let delegationNote = review.delegationNote, !delegationNote.isEmpty {")
  line = configure.index("if let pairingLine = review.pairingLine {")
  footnote = configure.index("root.addArrangedSubview(footnote)")
  separator = configure.index("let separator = NSBox()")
  abort "SudoAuthorizationReview.swift: the delegation note, then the pairing line, follow the footnote" unless
    note && line && footnote && separator && footnote < note && note < line && line < separator
  drawn = configure[line...separator]
  abort "SudoAuthorizationReview.swift: the pairing line is never truncated and carries the probes'"'"' identifier" unless
    drawn.include?("line.maximumNumberOfLines = 0") &&
    drawn.include?("line.identifier = PromptInteractionGraceProbe.pairingLineIdentifier")
' "$repo_root/agent/Sources/csec-sudo-review/main.swift" "$delegation_dir/SudoAuthorizationReview.swift"
ruby -e '
  panel, agent, ssh, service = ARGV.map { |path| File.read(path) }
  def body(source, signature)
    source[/#{Regexp.escape(signature)}.*?\n    }\n/m] or abort "missing #{signature}"
  end
  configure = body(panel, "private func configureWindow(")
  footnote = configure[/      if review\.automation == nil \{\n        let footnote = NSTextField\(.*?\n      \}\n/m] or
    abort "TrustedAccessReviewSession.swift: the shared footnote block is missing"
  abort "TrustedAccessReviewSession.swift: the delegation note and pairing line belong in the shared footnote block, never on a restore-only panel" unless
    footnote.include?("if !review.isRestoreOnly, let delegationNote = review.delegationNote {") &&
    footnote.include?("if !review.isRestoreOnly, let offer = review.pairingOffer {") &&
    panel.scan("review.delegationNote").size == 1
  panel.scan(/private (?:static )?func makeAutomation\w*\(.*?\n    }\n/m).each do |automation|
    abort "TrustedAccessReviewSession.swift: the automation layout never carries a delegation note" if automation =~ /delegation|delegated|pairing/i
  end
  access = body(agent, "private func handlePolicyAccess(")
  approved = access.index("guard case let .approved(approvedUnlock) = outcome else {")
  pairing = access.index("await delegation.recordHumanApproval(")
  abort "Agent.swift: a pairing is written once, after the human approval completed" unless
    approved && pairing && approved < pairing && agent.scan("recordHumanApproval(").size == 1
  gate = /let surface = approval\.decidedOn,\n\s*approval\.pairingLineShown,\n\s*pairingOffer\.applies\(/
  abort "Agent.swift: only an approval on a human surface that showed the pairing line pairs" unless
    access[approved...pairing] =~ gate
  abort "SSHSigningService.swift: an SSH panel offers and writes no pairing (csec-0.11)" if
    ssh =~ /recordHumanApproval\(|pairingOffer/
  abort "ClaudeDelegationService.swift: pairings are added only by recordHumanApproval and recordSudoApproval" unless
    service.scan("addPairing(").size == 3 &&
    service.scan(/public func recordHumanApproval\(.*?\n    }\n/m).all? { |fn| fn.include?("await addPairing(") }
  sudoApproval = body(service, "public func recordSudoApproval(")
  spent = sudoApproval.index("sudoOffers.removeValue(forKey: process)")
  added = sudoApproval.index("await addPairing(")
  abort "ClaudeDelegationService.swift: a sudo pairing needs the offer csecd made to that very helper, spent before it is added, " \
    "while the helper still serves a root sudo" unless
    spent && added && spent < added && sudoApproval.include?("sudo.executablePath == SudoChainRule.sudoPath") &&
    sudoApproval.include?("sudo.effectiveUID == 0")
' "$trusted_review" "$delegation_dir/Agent.swift" "$delegation_dir/SSHSigningService.swift" \
  "$delegation_dir/ClaudeDelegationService.swift"

# C2: the Claude settings gate and the settings transaction. csecd evaluates
# the gate on every delegated request, so it takes every root from its scope
# and never reads the environment or the command line, and it only reads:
# nothing in it opens a file for writing or moves one. Enabling checks the
# request csecd must record before it writes the settings, and writes before it
# asks csecd; disabling reads csecd's record, reverts, then disables; and
# disable and uninstall share the one revert, so no second revert path can
# undo something different.
ruby -e '
  gate, onboarding, main, setup = ARGV.map { |path| File.read(path) }
  code = gate.lines.reject { |line| line.strip.start_with?("//", "///") }.join
  %w[ProcessInfo getenv( CommandLine. setenv(].each do |token|
    abort "ClaudeSettingsGate.swift: the gate must not read the environment or argv (#{token})" if code.include?(token)
  end
  %w[O_WRONLY O_RDWR O_CREAT O_TRUNC .write(to: createFile( removeItem( moveItem( rename( unlink( renameat(].each do |token|
    abort "ClaudeSettingsGate.swift: the gate must never write (#{token})" if code.include?(token)
  end
  enable = onboarding[/public static func enable\(\n.*?\n    }\n/m] or
    abort "SetupOnboarding.swift: ClaudeDelegationSetup.enable is missing"
  lines = enable.lines
  checked = lines.index { |line| line.include?("guard request.isWellFormed") }
  applied = lines.index { |line| line.include?("try CodingAgentSetup.apply(configurationPlan)") }
  asked = lines.index { |line| line.include?("configureDelegation(") }
  abort "SetupOnboarding.swift: enable must check the request, then write the settings, then ask csecd once" unless
    checked && applied && asked && checked < applied && applied < asked &&
    enable.scan("configureDelegation(").size == 1 && lines[asked].include?("try client.configureDelegation(request)")
  disable = onboarding[/public static func disable\(\n.*?\n    }\n/m] or
    abort "SetupOnboarding.swift: ClaudeDelegationSetup.disable is missing"
  lines = disable.lines
  status = lines.index { |line| line.include?("configureDelegation(.status(") }
  revert = lines.index { |line| line.include?("revertRecordedSettings(") }
  off = lines.index { |line| line.include?("configureDelegation(.disable())") }
  abort "SetupOnboarding.swift: disable must read the record, revert, then disable" unless
    status && revert && off && status < revert && revert < off
  uninstall = main[/^func revertClaudeSettingsBeforeUninstall\(\)[^{\n]*\{\n.*?\n}\n/m] or
    abort "csec/main.swift: revertClaudeSettingsBeforeUninstall is missing"
  abort "csec/main.swift: uninstall must revert through ClaudeDelegationSetup.revertRecordedSettings" unless
    uninstall.include?("ClaudeDelegationSetup.revertRecordedSettings(")
  run = main[/^func runUninstall\(_ arguments: \[String\]\) -> Never \{\n.*?\n}\n/m] or
    abort "csec/main.swift: runUninstall is missing"
  preflight = run.index("CompleteUninstall.scriptProblem()")
  first_revert = run.index("revertClaudeSettingsBeforeUninstall()")
  cleanup = run.index("uninstallCleanup()")
  abort "csec/main.swift: uninstall must revert the Claude settings before csecd deletes its record" unless
    first_revert && cleanup && first_revert < cleanup
  # --all checks the package uninstaller before changing anything, removes the
  # fail-closed hooks only after the Touch ID (a refusal changes nothing), and
  # runs the system part, which deletes the app, only after the agent is
  # unregistered (SMAppService needs the bundle) and every hook is gone.
  hooks = run.index("removeCodingAgentHooksForUninstall()")
  unregister = run.index("LaunchAgentService.uninstall()")
  held = run.index("guard hooksRemoved else")
  system = run.index("runSystemUninstaller()")
  abort "csec/main.swift: uninstall --all must check its uninstaller first, remove the hooks after the cleanup, " \
        "and run the system part last, only when every hook is gone" unless
    preflight && hooks && unregister && held && system &&
    preflight < first_revert && cleanup < hooks && hooks < unregister && unregister < held && held < system
  abort "csec/SetupCommand.swift: setup must disable through ClaudeDelegationSetup.disable" unless
    setup.include?("ClaudeDelegationSetup.disable(")
  [["csec/main.swift", main], ["csec/SetupCommand.swift", setup]].each do |name, text|
    %w[planRevert planClaudeDelegationRevert planClaudeClassifyAllShellRemoval].each do |token|
      abort "#{name}: revert through ClaudeDelegationSetup, not #{token} directly" if text.include?(token)
    end
  end
' "$repo_root/agent/Sources/ConvenientSecurity/ClaudeSettingsGate.swift" \
  "$repo_root/agent/Sources/ConvenientSecurity/SetupOnboarding.swift" \
  "$repo_root/agent/Sources/csec/main.swift" \
  "$repo_root/agent/Sources/csec/SetupCommand.swift"

# Treat every Swift compiler warning as an error so a warning cannot silently
# accumulate on main. This applies package-wide to all current and future
# targets (no per-target opt-in to forget), gated here in the one build everyone
# runs before merging. Fix the warning; do not silence this flag.
swift build --package-path "$repo_root/agent" --jobs 2 -Xswiftc -warnings-as-errors
python3 "$repo_root/bin/test-ai-sandbox.py"
python3 "$repo_root/bin/test-output-redaction-lifetime.py"
# Where Google's tools keep a sign-in made from csec's own credential file:
# the real gcloud CLI and google-auth, offline, against the debug csec and
# cs-fake-agent (docs/machine-identity.md states what this checks).
if ! gcloud_sdk="$(cd "$repo_root" && mise where gcloud)"; then
  echo "error: the gcloud pinned in .tool-versions is missing; install it with: mise install -C \"$repo_root\" gcloud" >&2
  exit 1
fi
# The SDK's bundled libraries need the pinned Python; the runner's saved PATH
# can otherwise select macOS's Python 3.9 before the harness writes a report.
mise exec -C "$repo_root" -- python3 "$repo_root/bin/test-google-token-cache.py" "$gcloud_sdk"
# A standalone --*-only run reaches a panel suite's first spin of the main run
# loop with no suspension before it; cs-selftest's run-loop keeper must already
# be running by then, or that spin never returns. The full run below cannot
# show this, so run the standalone shape on its own, killed if it hangs.
/usr/bin/perl -e 'alarm shift; exec { $ARGV[0] } @ARGV or die "exec $ARGV[0]: $!\n"' 120 \
  "$repo_root/agent/.build/debug/cs-selftest" --main-run-loop-only
"$repo_root/agent/.build/debug/cs-selftest"
# cs-e2e drives the Node client from clients/node/dist, which is gitignored build
# output: build it from source first so the check never runs a stale or missing
# client.
npm run build --prefix "$repo_root"
"$repo_root/agent/.build/debug/cs-e2e"
for host_mode in ed25519-certificate ed25519 ecdsa rsa rsa-sha1; do
  CSEC_SSH_E2E_HOST_MODE="$host_mode" \
    "$repo_root/agent/.build/debug/cs-ssh-e2e"
