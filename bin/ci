#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
swift_scratch="${TMPDIR:-/tmp}/convenient-security-swift-cache"

export CLANG_MODULE_CACHE_PATH="$swift_scratch/clang"
export SWIFTPM_MODULECACHE_OVERRIDE="$swift_scratch/swiftpm"

bash -n \
  "$repo_root/packaging/bin/build-and-install.sh" \
  "$repo_root/packaging/bin/build-agent.sh" \
  "$repo_root/packaging/bin/build-pkg.sh" \
  "$repo_root/packaging/bin/build-sudo-pam.sh" \
  "$repo_root/packaging/bin/build-sudo-review.sh" \
  "$repo_root/packaging/bin/build-spike.sh" \
  "$repo_root/packaging/bin/install-sudo-pam.sh" \
  "$repo_root/packaging/bin/install-sudo-review.sh" \
  "$repo_root/packaging/bin/notarize.sh" \
  "$repo_root/packaging/bin/provision.sh" \
  "$repo_root/packaging/pkg-scripts/postinstall" \
  "$repo_root/packaging/pkg-scripts/reload-launch-daemon" \
  "$repo_root/packaging/tests/fake-launchctl.sh"

install_plan="$("$repo_root/packaging/bin/build-and-install.sh" --dry-run --refresh-profile)"
for expected_step in \
  "packaging/bin/provision.sh" \
  "packaging/bin/notarize.sh --check-auth" \
  "packaging/bin/build-agent.sh" \
  "packaging/bin/notarize.sh" \
  "packaging/bin/build-pkg.sh" \
  "/usr/bin/sudo /usr/sbin/installer" \
  "/Applications/ConvenientSecurity.app/Contents/MacOS/csec doctor" \
  "/Applications/ConvenientSecurity.app/Contents/MacOS/csec status"; do
  if [[ "$install_plan" != *"$expected_step"* ]]; then
    echo "build-and-install dry run omitted: $expected_step" >&2
    exit 1
  fi
done
if [[ "$install_plan" == *"sudo /Applications/ConvenientSecurity.app/Contents/MacOS/csec install"* ]]; then
  echo "build-and-install must not register the per-user agent with sudo" >&2
  exit 1
fi

# The ordinary signed app intentionally has no CloudKit entitlement. Constructing
# CKContainer in that build is a process-terminating programmer error on macOS,
# not a throwable availability failure, so startup must use the entitlement gate.
if ! rg -F -q 'CloudKitRemoteApprovalRelay.makeIfEntitled(' \
  "$repo_root/agent/Sources/csecd/AgentRuntime.swift"; then
  echo "csecd must gate optional CloudKit relay construction from signed entitlements" >&2
  exit 1
fi
postinstall_requirement_checks="$(
  rg -F -c -- '-R="$product_requirement and identifier' \
    "$repo_root/packaging/pkg-scripts/postinstall" || true
)"
if [ "$postinstall_requirement_checks" != "3" ]; then
  echo "postinstall must pass each codesign test requirement as one -R=<requirement> argument" >&2
  exit 1
fi
if ! rg -F -q 'reload-launch-daemon" /bin/launchctl' \
  "$repo_root/packaging/pkg-scripts/postinstall"; then
  echo "postinstall must use the bounded LaunchDaemon reload helper" >&2
  exit 1
fi

# Reproduce the launchd upgrade race deterministically: bootout returns while
# the old job is still visible, then the first bootstrap is rejected even after
# print stops finding it. The reload must wait, retry, and kickstart once.
(
  launchd_test_root="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/csec-launchd-test.XXXXXX")"
  trap '/bin/rm -rf "$launchd_test_root"' EXIT
  echo loaded >"$launchd_test_root/state"
  export CSEC_FAKE_LAUNCHCTL_STATE="$launchd_test_root"
  "$repo_root/packaging/pkg-scripts/reload-launch-daemon" \
    "$repo_root/packaging/tests/fake-launchctl.sh" \
    com.alexspeller.convenient-security.synthetic \
    /tmp/com.alexspeller.convenient-security.synthetic.plist
  [ "$(/bin/cat "$launchd_test_root/state")" = "loaded" ]
  [ "$(/bin/cat "$launchd_test_root/bootstrap-attempts")" = "2" ]
  [ "$(/bin/cat "$launchd_test_root/kickstarts")" = "1" ]
)

# Policy review hops from the socket handler to MainActor. A top-level await
# makes Swift run this entry point as one async main-actor job; blocking that job
# in NSApplication.run() then prevents every review window from appearing.
csecd_entrypoint="$repo_root/agent/Sources/csecd/main.swift"
if rg -q '^await\b' "$csecd_entrypoint"; then
  echo "csecd main.swift must stay synchronous; move async startup into AgentRuntime.swift" >&2
  exit 1
fi
csecd_event_loops="$(rg -c '^application\.run\(\)$' "$csecd_entrypoint" || true)"
csecd_detached_starts="$(
  rg -F -c 'Task.detached(priority: .userInitiated)' "$csecd_entrypoint" || true
)"
if [ "$csecd_event_loops" != "1" ] || [ "$csecd_detached_starts" != "1" ]; then
  echo "csecd must start its async runtime separately from the synchronous AppKit loop" >&2
  exit 1
fi
trusted_review="$repo_root/agent/Sources/ConvenientSecurity/TrustedAccessReviewSession.swift"
if rg -q 'authorizeButton|authorizePressed' "$trusted_review"; then
  echo "embedded Touch ID must not be gated by a preliminary authorize button" >&2
  exit 1
fi
if ! rg -U -q \
  'window\.makeKeyAndOrderFront\(nil\)\n\s*window\.displayIfNeeded\(\)\n\s*beginAuthentication\(\)' \
  "$trusted_review"; then
  echo "trusted review must activate Touch ID when its rendered window becomes visible" >&2
  exit 1
fi
plutil -lint \
  "$repo_root/packaging/agent/Info.plist" \
  "$repo_root/packaging/agent/csecd.entitlements" \
  "$repo_root/packaging/agent/csecd.remote-approval.development.entitlements" \
  "$repo_root/packaging/agent/csecd.remote-approval.entitlements" \
  "$repo_root/packaging/agent/LaunchAgents/com.alexspeller.convenient-security.plist" \
  "$repo_root/ios/ConvenientSecurityApproval/Info.plist" \
  "$repo_root/ios/ConvenientSecurityApproval/ConvenientSecurityApproval.entitlements" \
  "$repo_root/ios/ConvenientSecurityApproval/ConvenientSecurityApproval.production.entitlements" \
  "$repo_root/packaging/root/LaunchDaemons/com.alexspeller.convenient-security.rootd.plist"
iphone_development_environment="$(
  /usr/libexec/PlistBuddy -c 'Print :com.apple.developer.icloud-container-environment' \
    "$repo_root/ios/ConvenientSecurityApproval/ConvenientSecurityApproval.entitlements"
)"
iphone_production_environment="$(
  /usr/libexec/PlistBuddy -c 'Print :com.apple.developer.icloud-container-environment' \
    "$repo_root/ios/ConvenientSecurityApproval/ConvenientSecurityApproval.production.entitlements"
)"
mac_development_environment="$(
  /usr/libexec/PlistBuddy -c 'Print :com.apple.developer.icloud-container-environment' \
    "$repo_root/packaging/agent/csecd.remote-approval.development.entitlements"
)"
mac_production_environment="$(
  /usr/libexec/PlistBuddy -c 'Print :com.apple.developer.icloud-container-environment' \
    "$repo_root/packaging/agent/csecd.remote-approval.entitlements"
)"
if [ "$iphone_development_environment" != "Development" ] \
    || [ "$mac_development_environment" != "Development" ] \
    || [ "$iphone_production_environment" != "Production" ] \
    || [ "$mac_production_environment" != "Production" ]; then
  echo "Mac and iPhone CloudKit entitlements must stay aligned by build environment" >&2
  exit 1
fi
ruby -ryaml -e '
  project = YAML.safe_load(File.read(ARGV.fetch(0)))
  configs = project.dig("targets", "ConvenientSecurityApproval", "settings", "configs")
  expected = {
    "Debug" => "ConvenientSecurityApproval/ConvenientSecurityApproval.entitlements",
    "Release" => "ConvenientSecurityApproval/ConvenientSecurityApproval.production.entitlements",
  }
  actual = configs&.transform_values { |settings| settings["CODE_SIGN_ENTITLEMENTS"] }
  abort "iOS build configurations must select matching CloudKit entitlements" unless actual == expected
' "$repo_root/ios/project.yml"
# The release gate still needs a generated Xcode project and physical device,
# but CI rejects syntax drift in the checked-in iOS source shell immediately.
swiftc -frontend -parse \
  "$repo_root/ios/ConvenientSecurityApproval/ConvenientSecurityApprovalApp.swift" \
  "$repo_root/ios/ConvenientSecurityApproval/PhoneIdentityStore.swift" \
  "$repo_root/ios/ConvenientSecurityApproval/ApprovalViewModel.swift" \
  "$repo_root/ios/ConvenientSecurityApproval/ContentView.swift"
ruby -c "$repo_root/packaging/fastlane/Fastfile"
swiftc "$repo_root/packaging/spike/main.swift" \
  -o "$swift_scratch/keychain-spike-compile-check"
swiftc "$repo_root/packaging/spike/unentitled-keychain-probe.swift" \
  -o "$swift_scratch/unentitled-keychain-probe-compile-check"
clang -fsyntax-only -Wall -Wextra -Werror \
  -I "$repo_root/agent/Sources/CSecuritySupport/include" \
  "$repo_root/agent/Sources/CSecuritySupport/CSecuritySupport.c"
clang -fsyntax-only -Wall -Wextra -Werror \
  -I "$repo_root/agent/Sources/CSECSecretHeuristics/include" \
  "$repo_root/agent/Sources/CSECSecretHeuristics/CSECSecretHeuristics.c"
clang -fsyntax-only -Wall -Wextra -Werror \
  "$repo_root/agent/Sources/cs-file-probe/main.c"
clang -fsyntax-only -Wall -Wextra -Werror \
  "$repo_root/agent/Sources/cs-gh-fixture/main.c"

# Every distributed surface must carry the same FSL terms. RubyGems represents
# licences outside its SPDX allow-list as "Nonstandard"; LICENSE.md is the
# authoritative identifier and text.
cmp "$repo_root/LICENSE.md" "$repo_root/clients/ruby/LICENSE.md"
cmp "$repo_root/LICENSE.md" "$repo_root/clients/node/LICENSE.md"
(
  cd "$repo_root/clients/ruby"
  ruby -e '
    spec = Gem::Specification.load("convenient_security.gemspec")
    abort "gem licence metadata is not Nonstandard" unless spec.license == "Nonstandard"
    abort "gem omits LICENSE.md" unless spec.files.include?("LICENSE.md")
    abort "gem omits README.md" unless spec.files.include?("README.md")
    abort "RubyGems MFA is not required" unless spec.metadata["rubygems_mfa_required"] == "true"
  '
)
node -e '
  const spec = require(process.argv[1]);
  if (spec.license !== "SEE LICENSE IN LICENSE.md") {
    throw new Error("npm package licence metadata must point to LICENSE.md");
  }
  if (!spec.files.includes("LICENSE.md") || !spec.files.includes("README.md")) {
    throw new Error("npm package omits its licence or README");
  }
' "$repo_root/clients/node/package.json"

# Prove the inherited private-key handoff used by provisioning survives exec
# while remaining outside argv/environment/disk. The marker is synthetic test data.
fd_marker="csec-synthetic-inherited-fd"
exec 9< <(printf %s "$fd_marker")
ruby -e 'abort "inherited fd handoff failed" unless File.binread(ARGV.fetch(0)) == ARGV.fetch(1)' \
  /dev/fd/9 "$fd_marker"
exec 9<&-

# notarytool requires a filesystem path for --key. Prove its narrowly scoped
# staging helper uses private modes, preserves exact bytes, cleans on success,
# and removes a partial file when the producer fails. No real key or network is
# involved.
(
  source "$repo_root/packaging/bin/notarize.sh"
  notary_test_root="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/csec-notary-test.XXXXXX")"
  trap '/bin/rm -rf "$notary_test_root"' EXIT
  export TMPDIR="$notary_test_root"
  notary_marker="csec-synthetic-notary-key"

  stage_notary_key_from_command /usr/bin/printf %s "$notary_marker"
  [ "$(/usr/bin/stat -f %Lp "$notary_key_directory")" = "700" ]
  [ "$(/usr/bin/stat -f %Lp "$notary_key_file")" = "600" ]
  [ "$(/bin/cat "$notary_key_file")" = "$notary_marker" ]
  staged_key_directory="$notary_key_directory"
  staged_key_file="$notary_key_file"
  cleanup_notary_key
  [ ! -e "$staged_key_file" ]
  [ ! -e "$staged_key_directory" ]

  if stage_notary_key_from_command /bin/sh -c 'printf partial; exit 1'; then
    echo "notary key staging accepted a failed producer" >&2
    exit 1
  fi
  [ -z "$(/usr/bin/find "$notary_test_root" -mindepth 1 -print -quit)" ]
)

swift build --package-path "$repo_root/agent"
"$repo_root/agent/.build/debug/cs-selftest"
"$repo_root/agent/.build/debug/cs-e2e"
for host_mode in ed25519-certificate ed25519 ecdsa rsa rsa-sha1; do
  CSEC_SSH_E2E_HOST_MODE="$host_mode" \
    "$repo_root/agent/.build/debug/cs-ssh-e2e"
done

# Compile the shipping branches and prove environment-only test controls are
# absent there. The release self-test does not contact a real agent or vault.
swift build --package-path "$repo_root/agent" -c release
CSEC_SOCKET="/tmp/csec-release-must-ignore.sock" \
OP_CLI_PATH="/bin/false" \
CSEC_ROOT_SOCKET="/tmp/csec-root-release-must-ignore.sock" \
  "$repo_root/agent/.build/release/cs-selftest"

# Build the opt-in sudo PAM integration and exercise its value-free preview,
# redactor, wire-format, helper-signing, and malformed-input checks.
"$repo_root/packaging/bin/build-sudo-pam.sh"
"$repo_root/packaging/bin/build-sudo-review.sh"

# The shipping access-review window must use Apple's context-bound embedded UI;
# merely importing LocalAuthentication would regress to a second system alert.
shipping_agent="$repo_root/agent/.build/release/csecd"
if ! otool -L "$shipping_agent" | rg -q 'LocalAuthenticationEmbeddedUI'; then
  echo "release csecd does not link the embedded LocalAuthentication UI" >&2
  exit 1
fi
shipping_undefined_symbols="$(nm -u "$shipping_agent")"
# Do not use `nm | rg -q` here: with pipefail, rg closes the large nm stream
# after its match and nm's resulting SIGPIPE turns a successful check into 141.
if [[ "$shipping_undefined_symbols" != *"_OBJC_CLASS_\$_LAAuthenticationView"* ]]; then
  echo "release csecd does not reference LAAuthenticationView" >&2
  exit 1
fi

# The privileged daemon is intentionally built from dedicated minimal modules.
# A target dependency on the full user agent would silently pull UI, biometric,
# Keychain, provider, and ServiceManagement implementations into root.
rootd="$repo_root/agent/.build/release/csec-rootd"
rootd_links="$(otool -L "$rootd")"
if printf '%s\n' "$rootd_links" | rg -q \
  'AppKit|LocalAuthentication|ServiceManagement'; then
  echo "release csec-rootd links a forbidden user-agent framework" >&2
  exit 1
fi
if nm -gU "$rootd" | rg -q \
  'SecItem|LAContext|NSApplication|SMAppService|OnePassword|NativeEncrypted|Biometric'; then
  echo "release csec-rootd contains forbidden user-agent implementation symbols" >&2
  exit 1
fi

ruby -I"$repo_root/clients/ruby/lib" \
  "$repo_root/clients/ruby/test/convenient_security_test.rb"
ruby -I"$repo_root/clients/ruby/lib" \
  "$repo_root/clients/ruby/test/cross_stack_test.rb"
npm test --prefix "$repo_root"
npm run pack:check --prefix "$repo_root"
