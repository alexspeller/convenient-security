# Concurrent ssh share a review; interrupting ssh or killing its waiting parent
# withdraws that connection's pending review.
for ssh_scenario in concurrent interrupted orphaned; do
  CSEC_SSH_E2E_SCENARIO="$ssh_scenario" "$repo_root/agent/.build/debug/cs-ssh-e2e"
