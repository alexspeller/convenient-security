#!/usr/bin/env bash

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)" || exit 1
cd "$repo_root" || exit 1

status=0
# --text keeps a file git calls binary in the scan. Its bytes are not UTF-8,
# so awk reads them under LC_ALL=C, still matching the ASCII marker; and awk
# ends a record at a NUL, so each NUL becomes a space first.
git diff --cached --no-ext-diff --unified=0 --text --diff-filter=ACMR -- |
  LC_ALL=C tr '\000' ' ' |
  LC_ALL=C awk '
    /^diff --git / { in_hunk = 0; next }
    /^@@ / { in_hunk = 1; next }
    in_hunk && /^\+/ && index($0, "TO" "DO") { found = 1 }
    END { exit found ? 42 : 0 }
  ' || status=$?

case "$status" in
  0)
    exit 0
    ;;
  42)
    marker="TO""DO"
    echo "Commit blocked: staged additions contain ${marker}." >&2
    echo "Remove the marker, stage the correction, and retry the commit." >&2
    exit 1
    ;;
  *)
    echo "Unable to inspect staged additions; refusing the commit." >&2
    exit "$status"
    ;;
esac
